# GEMINI_API_KEY: Optional - enables dynamic Gemini AI-generated learning roadmaps.
# If omitted or unavailable, the application seamlessly utilizes rich built-in curated roadmaps.
GEMINI_API_KEY=""

# YOUTUBE_API_KEY: Optional - Google Cloud YouTube Data API v3 key for tutorial video recommendations.
# If omitted or quota-limited, the application provides direct community tutorial search links as a graceful fallback.
YOUTUBE_API_KEY=""

# APP_URL: The URL where this app is hosted locally.
APP_URL="http://localhost:3000"
